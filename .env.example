# CashBridge B2B SaaS Environment Variables Example

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=uz

# Supabase (PostgreSQL + Auth + Storage + RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend Transactional Email API (Invoice Delivery & Reminders)
RESEND_API_KEY=re_123456789_abcdef
RESEND_FROM_EMAIL=finance@cashbridge.uz

# Telegram Bot API (Instant Payment Reminders & Alerts)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_DEFAULT_CHAT_ID=@cashbridge_demo_channel
CRON_SECRET=your_super_secret_cron_key_here
